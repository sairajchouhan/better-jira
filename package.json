{
  "name": "better-jira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production sh -c 'while bun src/index.ts; do :; done'",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "setup": "bun scripts/setup.ts",
    "test:e2e": "bun test --timeout 60000 ./e2e/*.e2e.ts",
    "dev:personal": "bun --env-file=.env.personal --hot src/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/query-core": "5.107.1",
    "@tanstack/react-hotkeys": "^0.22.0",
    "bun-plugin-tailwind": "^0.1.2",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "1.92.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
