# Copy to .env, or run `bun run setup`.
JIRA_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-api-token
JIRA_BOARDS=123,456
# Optional: PORT=3000 and JIRA_CACHE=cache-private.db
# Edits go to Jira once `bun run setup` is answered yes. Without setup, set JIRA_WRITES to your site's https address;
# JIRA_WRITES=off keeps bun start local whatever setup saved.
