# Goes in instances/<name>/.env: bun run setup <name> writes it for you.
JIRA_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-api-token
JIRA_BOARDS=123,456
# Optional: PORT=3000, JIRA_CACHE=other.db to use a cache other than instances/<name>/cache.db, and JIRA_TRIPS=other.jsonl
# to keep trips to Jira somewhere other than instances/<name>/trips.jsonl
# Edits go to Jira once `bun run setup <name>` is answered yes. Without setup, set JIRA_WRITES to your site's https address;
# JIRA_WRITES=off keeps bun start local whatever setup saved.
